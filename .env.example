# Database configuration (PostgreSQL or SQLite)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/priya_health_care?schema=public"

# Admin Authentication Secret (JWT)
AUTH_SECRET="your-secure-random-jwt-secret-here-min-32-chars"

# Email Configuration (SMTP) - Optional
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="notifications@priyahealthcare.com"
EMAIL_PASSWORD=""
EMAIL_FROM="Priya Health Care <no-reply@priyahealthcare.com>"
ADMIN_EMAIL="admin@priyahealthcare.com"

# Storage Configuration (Cloudinary / S3 / Local)
STORAGE_PROVIDER="local"
STORAGE_API_KEY=""
STORAGE_SECRET=""

# Client environment variables (prefixed with VITE_)
VITE_SITE_URL="http://localhost:3000"
VITE_CLINIC_NAME="Priya Health Care"
VITE_CLINIC_LOCATION="Singahi"
VITE_DOCTOR_NAME="Dr. Gultun Paswan"
