generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN") // ADMIN, STAFF
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model Doctor {
  id             String   @id @default(uuid())
  name           String   @default("Dr. Gultun Paswan")
  designation    String   @default("Doctor")
  bio            String   @default("[ADD VERIFIED INFORMATION]")
  qualifications String   @default("[ADD VERIFIED INFORMATION]")
  experience     String   @default("[ADD VERIFIED INFORMATION]")
  specialties    String   @default("[ADD VERIFIED INFORMATION]")
  imageUrl       String?
  phone          String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Clinic {
  id            String   @id @default(uuid())
  name          String   @default("Priya Health Care")
  address       String   @default("[ADD VERIFIED INFORMATION]")
  city          String   @default("Singahi")
  state         String   @default("[ADD VERIFIED INFORMATION]")
  pincode       String   @default("[ADD VERIFIED INFORMATION]")
  latitude      Float?
  longitude     Float?
  phone         String   @default("[ADD VERIFIED INFORMATION]")
  whatsapp      String   @default("[ADD VERIFIED INFORMATION]")
  email         String   @default("[ADD VERIFIED INFORMATION]")
  openingHours  String   @default("[ADD VERIFIED INFORMATION]")
  googleMapsUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  shortDescription String
  description      String
  icon             String   @default("Stethoscope")
  imageUrl         String?
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Appointment {
  id              String   @id @default(uuid())
  appointmentId   String   @unique
  patientName     String
  phone           String
  email           String?
  appointmentDate String
  appointmentTime String
  reason          String
  message         String?
  status          String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([appointmentDate])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  status    String   @default("NEW") // NEW, READ, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  content     String
  rating      Int      @default(5)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FAQ {
  id           String   @id @default(uuid())
  question     String
  answer       String
  isPublished  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  altText      String
  category     String   @default("Clinic")
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                  String   @id @default("settings")
  clinicName          String   @default("Priya Health Care")
  tagline             String   @default("Trusted Healthcare, With Care That Puts Patients First.")
  phone               String   @default("[ADD VERIFIED INFORMATION]")
  whatsapp            String   @default("[ADD VERIFIED INFORMATION]")
  email               String   @default("[ADD VERIFIED INFORMATION]")
  address             String   @default("[ADD VERIFIED INFORMATION]")
  city                String   @default("Singahi")
  state               String   @default("[ADD VERIFIED INFORMATION]")
  pincode             String   @default("[ADD VERIFIED INFORMATION]")
  googleMapsUrl       String   @default("")
  logoUrl             String   @default("")
  faviconUrl          String   @default("")
  heroImageUrl        String   @default("")
  doctorImageUrl      String   @default("")
  socialLinks         String   @default("{}")
  seoTitle            String   @default("Priya Health Care | Dr. Gultun Paswan | Singahi")
  seoDescription      String   @default("Priya Health Care in Singahi, Dr. Gultun Paswan. Professional patient-centric healthcare, consultation and appointments.")
  workingDays         String   @default("Monday,Tuesday,Wednesday,Thursday,Friday,Saturday")
  openingTime         String   @default("09:00 AM")
  closingTime         String   @default("07:00 PM")
  appointmentDuration Int      @default(20)
  bufferTime          Int      @default(5)
  breakStart          String   @default("01:00 PM")
  breakEnd            String   @default("02:00 PM")
  blockedDates        String   @default("[]")
  updatedAt           DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(uuid())
  adminUserId   String?
  adminUserName String?
  action        String
  entity        String
  entityId      String?
  details       String?
  timestamp     DateTime @default(now())
}
